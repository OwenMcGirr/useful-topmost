{
  "name": "useful-topmost",
  "version": "2026.1.0-alpha.19",
  "description": "Frameless full-screen Electron dashboard whose widgets are generated on the fly by the OpenAI Codex CLI.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-builder --publish never",
    "package:win": "npm run build && electron-builder --win nsis --publish never",
    "package:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "electron",
    "codex",
    "dashboard",
    "ai",
    "widgets"
  ],
  "author": "Owen McGirr",
  "license": "MIT",
  "type": "commonjs",
  "homepage": "https://github.com/OwenMcGirr/useful-topmost#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OwenMcGirr/useful-topmost.git"
  },
  "bugs": {
    "url": "https://github.com/OwenMcGirr/useful-topmost/issues"
  },
  "build": {
    "appId": "com.owenmcgirr.useful-topmost",
    "productName": "useful-topmost",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "OwenMcGirr",
        "repo": "useful-topmost",
        "releaseType": "release"
      }
    ],
    "files": [
      "out/**/*",
      "resources/icon.png"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "directories": {
      "buildResources": "resources"
    },
    "mac": {
      "icon": "resources/icon.png"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Utility",
      "maintainer": "Owen McGirr <o.a.mcgirr@gmail.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "motion": "^12.40.0"
  }
}
